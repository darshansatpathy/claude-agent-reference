{
  "name": "prompt-caching-accounting",
  "description": "Cache reads are counted and priced at the cache rate",
  "prompt": "Check an order",
  "script": [
    {
      "tool_use": [
        {
          "name": "lookup_order",
          "input": {
            "order_id": "A-1001"
          }
        }
      ]
    },
    {
      "usage": [
        10,
        20
      ],
      "cache": [
        0,
        400
      ],
      "text": "It shipped."
    }
  ],
  "expect": {
    "terminated_by": "end_turn",
    "cache_read_tokens": 400,
    "cost_usd": 0.00035,
    "request_has_cache_control": true
  }
}
